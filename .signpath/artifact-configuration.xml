<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de artefacto para SignPath (cópiala en el proyecto de SignPath).
  El artefacto es el ZIP que sube el workflow de release con los cuatro .exe
  en la raíz; se firman todos con Authenticode.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="despeje-windows-*.exe" min-matches="2" max-matches="2" />
      <include path="despejew-windows-*.exe" min-matches="2" max-matches="2" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
